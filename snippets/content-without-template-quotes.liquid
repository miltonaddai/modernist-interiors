{%- comment -%}
  Drops unverifiable homepage testimonials, and rewrites a stale product
  no-JS delivery fallback (old main-product.liquid adds handling onto 3–7/5–8).
{%- endcomment -%}
{%- assign html = html
  | replace: 'Estimated delivery:  4–8 business days', 'Estimated delivery: 1–2 processing business days (Mon–Sat) plus 3–7 carrier business days after dispatch'
  | replace: 'Estimated delivery:  6–9 business days', 'Estimated delivery: 1–2 processing business days (Mon–Sat) plus 5–8 carrier business days after dispatch'
  | replace: 'Estimated delivery:  3–7 business days', 'Estimated delivery: 1–2 processing business days (Mon–Sat) plus 3–7 carrier business days after dispatch'
  | replace: 'Estimated delivery:  5–8 business days', 'Estimated delivery: 1–2 processing business days (Mon–Sat) plus 5–8 carrier business days after dispatch'
-%}
{%- if html contains '__testimonials"' -%}
  {%- assign tsplit = html | split: '__testimonials"' -%}
  {%- assign head_bits = tsplit[0] | split: '<section' -%}
  {%- assign head = '' -%}
  {%- assign last_idx = head_bits.size | minus: 1 -%}
  {%- for bit in head_bits -%}
    {%- if forloop.index0 < last_idx -%}
      {%- unless forloop.first -%}{%- assign head = head | append: '<section' -%}{%- endunless -%}
      {%- assign head = head | append: bit -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign tail_src = tsplit[1] -%}
  {%- assign skip = 1 -%}
  {%- if tail_src contains '<section' -%}{%- assign skip = 2 -%}{%- endif -%}
  {%- assign after = tail_src | split: '</section>' -%}
  {%- assign rest = '' -%}
  {%- assign started = false -%}
  {%- for bit in after -%}
    {%- if forloop.index0 >= skip -%}
      {%- if started -%}{%- assign rest = rest | append: '</section>' -%}{%- endif -%}
      {%- assign rest = rest | append: bit -%}
      {%- assign started = true -%}
    {%- endif -%}
  {%- endfor -%}
  {{ head }}{{ rest }}
{%- else -%}
  {{ html }}
{%- endif -%}
