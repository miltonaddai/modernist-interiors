{%- comment -%} Accepts: product, variant (optional) {%- endcomment -%}
{%- liquid
  if variant
    assign p = variant.price
    assign c = variant.compare_at_price
  else
    assign p = product.price
    assign c = product.compare_at_price
  endif
-%}
<div class="price{% if c > p %} price--sale{% endif %}">
  {%- if product.price_varies and variant == blank -%}
    {%- assign p_money = product.price_min | money -%}
    <span class="price__current"><span class="price__from">{{ 'products.product.from' | t }}</span><span class="price__amount">{{ p_money }}</span></span>
  {%- else -%}
    <span class="price__current"><span class="price__amount">{{ p | default: 0 | money }}</span></span>
  {%- endif -%}
  {%- if c > p -%}<s class="price__compare"><span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>{{ c | money }}</s>{%- endif -%}
</div>
