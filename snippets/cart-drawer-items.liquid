{%- if cart.item_count == 0 -%}
  <div class="drawer__empty">
    <p>{{ 'cart.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  </div>
{%- else -%}
  <ul class="cart-items" role="list">
    {%- for item in cart.items -%}
      <li class="cart-item">
        {%- if item.image -%}<a href="{{ item.url }}" class="cart-item__media">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}</a>{%- endif -%}
        <div class="cart-item__info">
          <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
          {%- unless item.product.has_only_default_variant -%}<p class="muted small">{{ item.variant.title }}</p>{%- endunless -%}
          <p class="small">{{ item.final_line_price | money }}</p>
          <div class="qty" data-line="{{ forloop.index }}">
            <button type="button" class="qty__btn" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t }}">&minus;</button>
            <span class="qty__val" aria-live="polite">{{ item.quantity }}</span>
            <button type="button" class="qty__btn" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t }}">+</button>
            <button type="button" class="link small" data-qty="0">{{ 'cart.remove' | t }}</button>
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>
  <div class="drawer__footer">
    <div class="drawer__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="button button--full drawer__checkout">
        <svg class="drawer__checkout-lock" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="11" width="12" height="9.5" rx="1.4"/><path d="M8.6 11V8.1a3.4 3.4 0 0 1 6.8 0V11"/></svg>
        <span>Secure payment</span>
      </button>
    </form>
    <p class="drawer__trust">Free shipping · {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">30-day returns</a>{% else %}30-day returns{% endif %}</p>
    <ul class="payment-icons drawer__payments" role="list">
      {%- assign skip_pay = 'bancontact,mbway,satispay,paypal,paypalexpress' | split: ',' -%}
      {%- for type in shop.enabled_payment_types -%}
        {%- assign type_key = type | downcase | replace: '-', '' | replace: '_', '' -%}
        {%- unless skip_pay contains type_key -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
    <a href="{{ routes.cart_url }}" class="link small center">{{ 'cart.view' | t }}</a>
  </div>
{%- endif -%}
