<cart-drawer id="CartDrawer" class="drawer" aria-hidden="true">
  <div class="drawer__overlay" data-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__header">
      <h2 id="CartDrawerTitle" class="h4">{{ 'cart.title' | t }}</h2>
      <button type="button" class="icon-btn" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    </div>
    <div class="drawer__body" id="CartDrawerBody">{% render 'cart-drawer-items' %}</div>
  </div>
</cart-drawer>
