{%- comment -%} Renders an inline SVG icon. Accepts: icon (cart|search|account|menu|chevron|close|arrow|return|lock|headset), size (px, optional) {%- endcomment -%}
{%- case icon -%}
{%- when 'cart' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 7h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
{%- when 'search' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
{%- when 'account' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
{%- when 'menu' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
{%- when 'chevron' -%}<svg aria-hidden="true" focusable="false" class="icon icon--chevron" width="{{ size | default: 16 }}" height="{{ size | default: 16 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m6 9 6 6 6-6"/></svg>
{%- when 'close' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6 6 18"/></svg>
{%- when 'arrow' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 16 }}" height="{{ size | default: 16 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
{%- when 'return' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 15.5 4.5 10.5l5-5"/><path d="M4.5 10.5H15a5 5 0 0 1 0 10h-4"/></svg>
{%- when 'lock' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="11" width="12" height="9.5" rx="1.4"/><path d="M8.6 11V8.1a3.4 3.4 0 0 1 6.8 0V11"/></svg>
{%- when 'headset' -%}<svg aria-hidden="true" focusable="false" class="icon icon--{{ icon }}" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 13.5v3.2A1.8 1.8 0 0 0 6.3 18.5h1.4v-7H6.3a1.8 1.8 0 0 0-1.8 1.8z"/><path d="M19.5 13.5v3.2a1.8 1.8 0 0 1-1.8 1.8h-1.4v-7h1.4a1.8 1.8 0 0 1 1.8 1.8z"/><path d="M4.5 13.8a7.5 7.5 0 0 1 15 0"/><path d="M16.4 18.5c0 1.5-2 2.6-4.4 2.6"/></svg>
{%- endcase -%}
