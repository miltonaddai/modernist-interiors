<section class="section" style="--pt: 64px; --pb: 64px;">
  <div class="page-width narrow">
    <h1 class="h1 page-header">{{ 'customer.addresses' | t }}</h1>
    <p><a href="{{ routes.account_url }}" class="link">{{ 'customer.back' | t }}</a></p>
    {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="address-card">
        {{ address | format_address }}
        {%- if address == customer.default_address -%}<p class="eyebrow">{{ 'customer.default' | t }}</p>{%- endif -%}
        <details class="accordion"><summary>{{ 'customer.edit' | t }}</summary>
          {%- form 'customer_address', address, class: 'form-stack' -%}{% render 'address-fields', form: form, id: address.id %}<button class="button">{{ 'customer.save' | t }}</button>{%- endform -%}
        </details>
        <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" data-confirm="{{ 'customer.delete_confirm' | t }}"><input type="hidden" name="_method" value="delete"><button class="link small" type="submit">{{ 'customer.delete' | t }}</button></form>
      </div>
    {%- endfor -%}
    {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
    <details class="accordion"><summary>{{ 'customer.add_address' | t }}</summary>
      {%- form 'customer_address', customer.new_address, class: 'form-stack' -%}{% render 'address-fields', form: form, id: 'new' %}<button class="button">{{ 'customer.save' | t }}</button>{%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Addresses",
  "tag": "section",
  "class": "section-main-addresses",
  "settings": []
}
{% endschema %}
