<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <ul class="values" role="list">
      {%- for block in section.blocks -%}
        <li class="values__item reveal" {{ block.shopify_attributes }}>
          {%- case block.settings.shape -%}
            {%- when 'truck' -%}
              <svg class="values__svg values__svg--wide" viewBox="0 0 36 24" aria-hidden="true" focusable="false"><rect x="0" y="3" width="21" height="13" fill="#D0342C"/><path d="M23 7h6l5 5v4H23z" fill="#1F4E9C"/><rect x="0" y="16" width="34" height="2" fill="#111"/><circle cx="7" cy="19.5" r="3.5" fill="#111"/><circle cx="27" cy="19.5" r="3.5" fill="#111"/><circle cx="7" cy="19.5" r="1.2" fill="#F2B705"/><circle cx="27" cy="19.5" r="1.2" fill="#F2B705"/></svg>
            {%- when 'arch' -%}
              <svg class="values__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12a10 10 0 0 1 20 0z" fill="#1F4E9C"/><rect x="2" y="12" width="20" height="12" fill="#111"/><rect x="9" y="15" width="6" height="9" fill="#F2B705"/></svg>
            {%- else -%}
              <span class="values__icon values__icon--{{ block.settings.shape }}" aria-hidden="true"></span>
          {%- endcase -%}
          <h3 class="values__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="muted small">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "tag": "section",
  "class": "section-value-props",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "alt",
          "label": "Sage"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "shape",
          "label": "Bauhaus shape",
          "default": "circle",
          "options": [
            {
              "value": "circle",
              "label": "Circle (red)"
            },
            {
              "value": "square",
              "label": "Square (blue)"
            },
            {
              "value": "triangle",
              "label": "Triangle (yellow)"
            },
            {
              "value": "truck",
              "label": "Delivery truck"
            },
            {
              "value": "arch",
              "label": "Bauhaus arch"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "On every order, tracked to your door."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        {
          "type": "value"
        },
        {
          "type": "value"
        },
        {
          "type": "value"
        }
      ]
    }
  ]
}
{% endschema %}
