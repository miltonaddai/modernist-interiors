<footer class="footer scheme-{{ section.settings.color_scheme }}">
  <div class="page-width footer__grid">
    {%- for block in section.blocks -%}
      <div class="footer__block" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul role="list">{%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
          {%- when 'text' -%}
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <div class="rte">{{ block.settings.text }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="page-width footer__bottom">
    <p class="small">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ powered_by_link }}</p>
    {%- if section.settings.show_payment -%}
      <ul class="payment-icons" role="list">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}</ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "alt",
          "label": "Sage"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Modernist Interiors"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Modern furniture and objects for considered living.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
