{% comment %} Claim correction: unverifiable template quotes are not rendered. {% endcomment %}
{%- assign quote_count = 0 -%}
{%- for block in section.blocks -%}
  {%- assign quote_author = block.settings.author | downcase -%}
  {%- assign skip_quote = false -%}
  {%- if quote_author contains 'hannah' -%}{%- assign skip_quote = true -%}{%- endif -%}
  {%- if quote_author contains 'marco' -%}{%- assign skip_quote = true -%}{%- endif -%}
  {%- if quote_author contains 'sofie' -%}{%- assign skip_quote = true -%}{%- endif -%}
  {%- if block.settings.quote != blank and skip_quote == false -%}
    {%- assign quote_count = quote_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- if quote_count > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- assign testimonial_heading = section.settings.heading -%}
    {%- if testimonial_heading == 'Lived with, loved' -%}{%- assign testimonial_heading = '' -%}{%- endif -%}
    {%- if testimonial_heading != blank -%}<h2 class="h2 center reveal">{{ testimonial_heading }}</h2>{%- endif -%}
    <ul class="quotes scroller scroller--mobile" role="list">
      {%- for block in section.blocks -%}
        {%- assign quote_author = block.settings.author | downcase -%}
        {%- assign skip_quote = false -%}
        {%- if quote_author contains 'hannah' -%}{%- assign skip_quote = true -%}{%- endif -%}
        {%- if quote_author contains 'marco' -%}{%- assign skip_quote = true -%}{%- endif -%}
        {%- if quote_author contains 'sofie' -%}{%- assign skip_quote = true -%}{%- endif -%}
        {%- if block.settings.quote != blank and skip_quote == false -%}
          <li class="reveal" {{ block.shopify_attributes }}>
            <figure class="quote">
              {%- if block.settings.rating > 0 -%}<p class="quote__stars" aria-label="{{ block.settings.rating }} / 5">{% for i in (1..block.settings.rating) %}&#9733;{% endfor %}</p>{%- endif -%}
              <blockquote class="quote__text">{{ block.settings.quote }}</blockquote>
              {%- if block.settings.author != blank -%}<figcaption class="small muted">{{ block.settings.author }}</figcaption>{%- endif -%}
            </figure>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "alt",
          "label": "Sage"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
