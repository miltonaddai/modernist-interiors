<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="h2 center reveal">{{ section.settings.heading }}</h2>{%- endif -%}
    <ul class="quotes scroller scroller--mobile" role="list">
      {%- for block in section.blocks -%}
        <li class="reveal" {{ block.shopify_attributes }}>
          <figure class="quote">
            <p class="quote__stars" aria-label="{{ block.settings.rating }} / 5">{% for i in (1..block.settings.rating) %}&#9733;{% endfor %}</p>
            <blockquote class="quote__text">{{ block.settings.quote }}</blockquote>
            <figcaption class="small muted">{{ block.settings.author }}</figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lived with, loved"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "alt",
          "label": "Sage"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The pendant looks even better in person. Clean lines, beautiful glass."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
