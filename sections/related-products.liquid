<section class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="page-width">
    <h2 class="h3 section-head">{{ section.settings.heading }}</h2>
    <ul class="grid grid--products" role="list" style="--cols-desktop: 3; --cols-mobile: 2;">
      {%- for product in recommendations.products -%}<li>{% render 'product-card', product: product, show_secondary_image: true %}</li>{%- endfor -%}
    </ul>
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-related",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well with"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
