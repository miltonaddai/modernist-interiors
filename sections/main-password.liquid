<section class="password scheme-{{ section.settings.color_scheme }}">
  <div class="page-width narrow center">
    <h1 class="h1">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>{%- else -%}
      <div class="newsletter__row"><label for="PwEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label><input id="PwEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.label' | t }}"><button class="button" type="submit">{{ 'password.notify' | t }}</button></div>
      {%- endif -%}
    {%- endform -%}
    <details class="accordion">
      <summary>{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter' -%}
        {{ form.errors | default_errors }}
        <div class="newsletter__row"><label for="Pw" class="visually-hidden">{{ 'password.password' | t }}</label><input id="Pw" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}"><button class="button" type="submit">{{ 'password.enter' | t }}</button></div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "alt",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "alt",
          "label": "Sage"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ]
    }
  ]
}
{% endschema %}
