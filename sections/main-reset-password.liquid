<section class="section" style="--pt: 64px; --pb: 64px;">
  <div class="page-width narrow">
    <h1 class="h1 page-header">{{ 'customer.reset_title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form-stack' -%}
      {{ form.errors | default_errors }}
      <label for="RstPw">{{ 'customer.password' | t }}</label><input id="RstPw" type="password" name="customer[password]" autocomplete="new-password" required>
      <label for="RstPw2">{{ 'customer.password_confirm' | t }}</label><input id="RstPw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="button">{{ 'customer.reset' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "section-main-reset-password",
  "settings": []
}
{% endschema %}
