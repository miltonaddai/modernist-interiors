<section class="section" style="--pt: 64px; --pb: 64px;">
  <div class="page-width narrow">
    <h1 class="h1 page-header">{{ 'customer.create_account' | t }}</h1>
    {%- form 'create_customer', class: 'form-stack' -%}
      {{ form.errors | default_errors }}
      <label for="RegFirst">{{ 'customer.first_name' | t }}</label><input id="RegFirst" name="customer[first_name]" autocomplete="given-name">
      <label for="RegLast">{{ 'customer.last_name' | t }}</label><input id="RegLast" name="customer[last_name]" autocomplete="family-name">
      <label for="RegEmail">{{ 'customer.email' | t }}</label><input id="RegEmail" type="email" name="customer[email]" autocomplete="email" required>
      <label for="RegPassword">{{ 'customer.password' | t }}</label><input id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      <button class="button">{{ 'customer.create' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Register",
  "tag": "section",
  "class": "section-main-register",
  "settings": []
}
{% endschema %}
