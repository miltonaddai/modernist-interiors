<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_foreground }}">
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
<title>{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
{% render 'meta-tags' %}
{{ settings.type_body_font | font_face: font_display: 'swap' }}
{{ settings.type_heading_font | font_face: font_display: 'swap' }}
{% render 'css-variables' %}
{{ 'base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
{{ content_for_header }}
</head>
<body class="template-password">
<main id="MainContent" class="main" role="main">
{{ content_for_layout }}
</main>
</body>
</html>
